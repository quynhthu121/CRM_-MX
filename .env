# ===== Cấu hình môi trường Docker – Frappe CRM Điện Máy Xanh =====
# Tên site (truy cập http://dmx.localhost:8000)
SITE_NAME=dmx.localhost
# Cổng web trên máy của bạn (đổi nếu 8000 đã bị chiếm, ví dụ 8080)
HTTP_PORT=8000

# Mật khẩu root của MariaDB (chỉ dùng trong Docker trên máy cá nhân)
DB_ROOT_PASSWORD=dmx@2026
# Mật khẩu tài khoản Administrator và các tài khoản nhóm sau khi khôi phục
ADMIN_PASSWORD=admin123

# ----- Tài khoản quản trị CÁ NHÂN (tiêu chí A4.3.2: email admin là email của chính bạn) -----
# Mỗi thành viên sửa 2 dòng dưới đây thành email + họ tên của mình TRƯỚC KHI chạy `docker compose up -d`.
# Script sẽ tạo/cập nhật tài khoản này với quyền System Manager và mật khẩu = ADMIN_PASSWORD.
OWNER_EMAIL=quynhthu3677@gmail.com
OWNER_FULL_NAME=Đinh Thị Quỳnh Thư

# (Tuỳ chọn) Gmail App Password để Email Account gửi/nhận thư thật – để trống nếu chưa dùng
GMAIL_APP_PASSWORD=
